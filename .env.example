# App
BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:8000

# Neon Postgres (psycopg 3). Include sslmode=require on both URLs.
# Pooled connection string for the running app:
DATABASE_URL=
# Direct (non-pooled) connection string for Alembic migrations:
DATABASE_URL_DIRECT=
# Direct (non-pooled) URL of a separate Neon branch named test; never the production branch:
TEST_DATABASE_URL=

# WorkOS AuthKit
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# URL-safe base64 Fernet key (44 characters, ends with "="). Generate with:
# python3 -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
WORKOS_COOKIE_PASSWORD=
# e.g. https://your-project-xxxxx.authkit.app
AUTHKIT_DOMAIN=

# Finnhub (US quotes on the free plan; key via X-Finnhub-Token header)
FINNHUB_API_KEY=
